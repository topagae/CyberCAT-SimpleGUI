+
+        lock (RedNames)
+        {
+            var existing = GetCSNameFromRedName(redName);
+            if (existing != null)
+            {
+                return existing;
+            }
+
+            var underlyingType = Enum.GetUnderlyingType(Type);
+            var maxValue = Convert.ToDecimal(underlyingType.GetField("MaxValue")!.GetValue(null));
+
+            var nextValue = Enum.GetValues(Type).Cast<object>().Select(Convert.ToDecimal).DefaultIfEmpty(0).Max() + 1;
+            nextValue = Math.Max(nextValue, RedNames.Values.Select(x => decimal.TryParse(x, out var d) ? d + 1 : 0).DefaultIfEmpty(0).Max());
+            if (nextValue > maxValue)
+            {
+                return null;
+            }
+
+            var csName = Enum.ToObject(Type, Convert.ChangeType(nextValue, underlyingType)).ToString();
+            RedNames.Add(redName, csName);
+
+            return csName;
+        }
+    }
