<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained release build: dotnet publish CP2077SaveEditor/CP2077SaveEditor.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildProjectDirectory)\..\releases\v$(InformationalVersion)\</PublishDir>
  </PropertyGroup>
</Project>
