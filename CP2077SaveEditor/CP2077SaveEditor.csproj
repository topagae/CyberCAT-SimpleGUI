<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>

    <!--
      DisplayVersion is what users see: title bar, status bar, credits and the release folder name.
      InformationalVersion must stay valid SemVer. WolvenKit parses it strictly when it reads or writes
      appearance presets, and a version like "0.29c" made that throw. Bump both when releasing.
    -->
    <DisplayVersion>0.29d</DisplayVersion>
    <Version>0.29.3</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CyberCAT-SimpleGUI</Product>
    <Description>Cyberpunk 2077 save editor, patch 2.5 update (unofficial fork of CyberCAT-SimpleGUI by Deweh)</Description>
    <Copyright>Copyright (c) 2021 DeweySalt and contributors</Copyright>

    <!-- Only ship English resources of the framework -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Read at runtime by AppInfo.DisplayVersion -->
  <ItemGroup>
    <AssemblyMetadata Include="DisplayVersion" Value="$(DisplayVersion)" />
  </ItemGroup>

  <!-- Docs and licenses for release builds, see Properties\PublishProfiles\win-x64.pubxml -->
  <ItemGroup>
    <None Include="..\README.md;..\RELEASE_NOTES.md;..\NOTICE.md;..\LICENSE" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\licenses\**" LinkBase="licenses" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    WolvenKit.Core ships native libraries the editor never loads: wwtools (Wwise audio conversion) and the Linux/macOS
    builds. Unsigned native binaries draw antivirus false positives, so they are left out of the release.
    kraken.dll stays, saves are compressed with it.
  -->
  <Target Name="RemoveUnusedNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'wwtools.dll' Or '%(Extension)' == '.so' Or '%(Extension)' == '.dylib'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Resources\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WolvenKit\WolvenKit.Common\WolvenKit.Common.csproj" />
    <ProjectReference Include="..\WolvenKit\WolvenKit.Core\WolvenKit.Core.csproj" />
    <ProjectReference Include="..\WolvenKit\WolvenKit.RED4\WolvenKit.RED4.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Incremental builds don't notice changes to the files Resources.resx links to (Resources\*), and kept embedding
    the old ones. Deleting the compiled resources when one of them is newer makes them build again.
  -->
  <Target Name="RebuildChangedLinkedResources" BeforeTargets="CoreResGen" Inputs="@(Resource)" Outputs="$(IntermediateOutputPath)$(RootNamespace).Properties.Resources.resources">
    <Delete Files="$(IntermediateOutputPath)$(RootNamespace).Properties.Resources.resources" />
  </Target>

</Project>